# AgentBus — Configuration Template
# Copy to .env and fill in real values. .env is gitignored.

# Master Key for admin operations
AGENT_BUS_MASTER_KEY=<generate-a-secure-key>

# Database path
AGENT_BUS_DB=agent_bus.db

# Server settings
AGENT_BUS_PORT=7700

# Task timeouts
TASK_TIMEOUT_HOURS=2
HEARTBEAT_DEAD_THRESHOLD=5400

# Agent credentials (fill after registering agents)
ECHO_API_KEY=ab_xxxxxxxxxxxx
CC_MACMINI_API_KEY=ab_xxxxxxxxxxxx
